{
  "$defs": {
    "Distribution": {
      "enum": [
        "normal",
        "lognormal",
        "uniform",
        "posterior_samples"
      ],
      "title": "Distribution",
      "type": "string"
    },
    "Extraction": {
      "enum": [
        "tabular_text",
        "digitized_figure",
        "abstract_statement",
        "database_record",
        "computed"
      ],
      "title": "Extraction",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Origin of a record (DATA_SCHEMA, Provenance).",
      "properties": {
        "created": {
          "format": "date-time",
          "title": "Created",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "settings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Hash"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "identifier"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "experimental_observation",
        "published_computation",
        "computed_here",
        "model_prediction",
        "derived"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "Quantity": {
      "enum": [
        "E_bind_H_half_H2",
        "E_bind_H_atom",
        "E_bind_H2",
        "E_sequential",
        "E_barrier_stick",
        "E_barrier_recomb",
        "E_formation_defect",
        "E_migration"
      ],
      "title": "Quantity",
      "type": "string"
    },
    "ReferenceState": {
      "enum": [
        "half_H2",
        "H_atom",
        "H2_molecule",
        "pristine_cell"
      ],
      "title": "ReferenceState",
      "type": "string"
    },
    "SiteClassName": {
      "enum": [
        "basal",
        "monovacancy",
        "divacancy_585",
        "divacancy_555777",
        "stone_wales",
        "edge_zigzag",
        "edge_armchair",
        "cnt_armchair",
        "cnt_zigzag",
        "epoxide",
        "hydroxyl",
        "carbonyl_pair",
        "carboxyl",
        "mixed_vacancy_cnt",
        "mixed_sw_cnt",
        "pore_slit",
        "cnt_interior",
        "cnt_interstitial",
        "cnt_groove"
      ],
      "title": "SiteClassName",
      "type": "string"
    },
    "SiteDescriptors": {
      "additionalProperties": false,
      "description": "Local descriptors of a site carbon (DATA_SCHEMA, SiteSpec.descriptors).",
      "properties": {
        "coordination": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordination"
        },
        "curvature_inv_nm": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curvature Inv Nm"
        },
        "distance_to_defect_nm": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance To Defect Nm"
        },
        "n_neighbor_H": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Neighbor H"
        },
        "pyramidalization_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pyramidalization Deg"
        }
      },
      "title": "SiteDescriptors",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "potential"
      ],
      "title": "Tier",
      "type": "string"
    },
    "UncertainScalar": {
      "additionalProperties": false,
      "description": "A scalar with uncertainty (DATA_SCHEMA, Uncertainty).",
      "properties": {
        "components": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "normal"
        },
        "samples_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples Ref"
        },
        "sigma": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sigma",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "UncertainScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One energy of one configuration at one fidelity tier (DATA_SCHEMA, SiteEnergyRecord).\n\nThe optional fields beyond the specification (site class, site identifier, hydrogen count,\ndescriptors, cell size) make the landscape table self-describing; the schema minor version\npermits optional additions only.",
  "properties": {
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "descriptors": {
      "anyOf": [
        {
          "$ref": "#/$defs/SiteDescriptors"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "n_H": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N H"
    },
    "n_atoms": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Atoms"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "quantity": {
      "$ref": "#/$defs/Quantity"
    },
    "reference_state": {
      "$ref": "#/$defs/ReferenceState"
    },
    "site_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/SiteClassName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "site_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site Id"
    },
    "supercell": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supercell"
    },
    "temperature_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature K"
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "value": {
      "$ref": "#/$defs/UncertainScalar"
    }
  },
  "required": [
    "config_hash",
    "tier",
    "engine",
    "quantity",
    "value",
    "reference_state",
    "converged",
    "provenance"
  ],
  "title": "SiteEnergyRecord",
  "type": "object"
}
