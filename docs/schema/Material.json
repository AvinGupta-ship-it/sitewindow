{
  "$defs": {
    "Distribution": {
      "enum": [
        "normal",
        "lognormal",
        "uniform",
        "posterior_samples"
      ],
      "title": "Distribution",
      "type": "string"
    },
    "MaterialClass": {
      "enum": [
        "graphene",
        "rGO",
        "GO",
        "SWCNT",
        "MWCNT",
        "activated_carbon",
        "templated_carbon",
        "carbon_other",
        "non_carbon"
      ],
      "title": "MaterialClass",
      "type": "string"
    },
    "UncertainScalar": {
      "additionalProperties": false,
      "description": "A scalar with uncertainty (DATA_SCHEMA, Uncertainty).",
      "properties": {
        "components": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "normal"
        },
        "samples_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples Ref"
        },
        "sigma": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sigma",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "UncertainScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bet_area_m2_g": {
      "anyOf": [
        {
          "$ref": "#/$defs/UncertainScalar"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "conflict_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Group"
    },
    "material_class": {
      "$ref": "#/$defs/MaterialClass"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "oxygen_content_at": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oxygen Content At"
    },
    "pore_volume_cm3_g": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pore Volume Cm3 G"
    },
    "registry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registry Id"
    }
  },
  "required": [
    "name",
    "material_class"
  ],
  "title": "Material",
  "type": "object"
}
