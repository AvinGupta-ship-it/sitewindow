{
  "$defs": {
    "Distribution": {
      "enum": [
        "normal",
        "lognormal",
        "uniform",
        "posterior_samples"
      ],
      "title": "Distribution",
      "type": "string"
    },
    "Extraction": {
      "enum": [
        "tabular_text",
        "digitized_figure",
        "abstract_statement",
        "database_record",
        "computed"
      ],
      "title": "Extraction",
      "type": "string"
    },
    "LimitingMechanism": {
      "enum": [
        "thermodynamic",
        "kinetic_release",
        "kinetic_charge",
        "mass_limited"
      ],
      "title": "LimitingMechanism",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Origin of a record (DATA_SCHEMA, Provenance).",
      "properties": {
        "created": {
          "format": "date-time",
          "title": "Created",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "settings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Hash"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "identifier"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "experimental_observation",
        "published_computation",
        "computed_here",
        "model_prediction",
        "derived"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "UncertainScalar": {
      "additionalProperties": false,
      "description": "A scalar with uncertainty (DATA_SCHEMA, Uncertainty).",
      "properties": {
        "components": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "normal"
        },
        "samples_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples Ref"
        },
        "sigma": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sigma",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "UncertainScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "D_dischargeable_wt_percent": {
      "anyOf": [
        {
          "$ref": "#/$defs/UncertainScalar"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "D_wt_percent": {
      "$ref": "#/$defs/UncertainScalar"
    },
    "deficits": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Deficits",
      "type": "object"
    },
    "landscape_hash": {
      "title": "Landscape Hash",
      "type": "string"
    },
    "limiting_mechanism": {
      "$ref": "#/$defs/LimitingMechanism"
    },
    "per_class": {
      "additionalProperties": true,
      "title": "Per Class",
      "type": "object"
    },
    "population_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Population Hash"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "window": {
      "title": "Window",
      "type": "string"
    }
  },
  "required": [
    "window",
    "landscape_hash",
    "D_wt_percent",
    "limiting_mechanism",
    "provenance"
  ],
  "title": "CapacityResult",
  "type": "object"
}
