{
  "$defs": {
    "Distribution": {
      "enum": [
        "normal",
        "lognormal",
        "uniform",
        "posterior_samples"
      ],
      "title": "Distribution",
      "type": "string"
    },
    "Extraction": {
      "enum": [
        "tabular_text",
        "digitized_figure",
        "abstract_statement",
        "database_record",
        "computed"
      ],
      "title": "Extraction",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Origin of a record (DATA_SCHEMA, Provenance).",
      "properties": {
        "created": {
          "format": "date-time",
          "title": "Created",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "settings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Hash"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "identifier"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "experimental_observation",
        "published_computation",
        "computed_here",
        "model_prediction",
        "derived"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "UncertainScalar": {
      "additionalProperties": false,
      "description": "A scalar with uncertainty (DATA_SCHEMA, Uncertainty).",
      "properties": {
        "components": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "default": "normal"
        },
        "samples_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples Ref"
        },
        "sigma": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sigma",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "UncertainScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "admissibility_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Admissibility Reason"
    },
    "admissible": {
      "title": "Admissible",
      "type": "boolean"
    },
    "beam_energy_keV": {
      "exclusiveMinimum": 0.0,
      "title": "Beam Energy Kev",
      "type": "number"
    },
    "densities": {
      "additionalProperties": {
        "$ref": "#/$defs/UncertainScalar"
      },
      "title": "Densities",
      "type": "object"
    },
    "fluence_e_nm2": {
      "minimum": 0.0,
      "title": "Fluence E Nm2",
      "type": "number"
    },
    "material": {
      "title": "Material",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "raman": {
      "additionalProperties": true,
      "title": "Raman",
      "type": "object"
    },
    "temperature_K": {
      "exclusiveMinimum": 0.0,
      "title": "Temperature K",
      "type": "number"
    },
    "x_total": {
      "$ref": "#/$defs/UncertainScalar"
    }
  },
  "required": [
    "material",
    "beam_energy_keV",
    "fluence_e_nm2",
    "temperature_K",
    "densities",
    "x_total",
    "admissible",
    "provenance"
  ],
  "title": "DefectPopulation",
  "type": "object"
}
